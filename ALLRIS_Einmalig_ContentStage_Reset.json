    {
      "parameters": {
        "jsCode": "// Traegt hier jeweils die Zeilen ein, deren contentStage manuell zurueckgesetzt werden soll\n// (z.B. Zeilen, die P7 mit blosser Kurzfassung \"erledigt\" hat, bevor P4 echten Content\n// erzeugen konnte - siehe Fix \"P7: Wettlauf gegen P4\" vom 2026-07-25). Ein Item pro Zeile,\n// die dataTable-Node darunter aktualisiert dann jede Zeile einzeln per vorgangKey-Match.\nconst TARGETS = [\n  { vorgangKey: 'vol_10644', vorgangsnummer: '2026/139' },\n  { vorgangKey: 'vol_10700', vorgangsnummer: '2026/175' },\n  { vorgangKey: 'vol_10707', vorgangsnummer: '2026/180' }\n];\n\nif (!TARGETS.length) {\n  throw new Error('[ContentStage-Reset] TARGETS im Node \"Konfiguriere Ziele\" befuellen.');\n}\n\nreturn TARGETS.map(t => ({ json: { vorgangKey: t.vorgangKey, vorgangsnummer: t.vorgangsnummer, contentStage: 'needs_content' } }));"
      },
      "id": "e1a2b3c4-0002-4aaa-9bbb-000000000002",
      "name": "Konfiguriere Ziele",
      "type": "n8n-nodes-base.code",
