        "jsCode": "function safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction stripHtml(html) {\n  return safeStr(html)\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#039;/g, \"'\")\n    .replace(/\\s+/g, ' ').trim();\n}\nfunction hasMojibake(s) {\n  return /Ã[¤¶¼\\x9f\\u0084\\u0096\\u009c]|â€[žœ¦\\x9c\\x9d]/.test(s);\n}\n\nconst idx = $itemIndex;\nconst ctx = $('Filter veroeffentlichte Beitraege').itemMatching(idx).json;\nconst resp = $input.item.json || {};\n\nconst fetchError = resp.error || (resp.code && resp.message) ? true : false;\nif (fetchError || !resp.id) {\n  return [{ json: { ...ctx, _fetchError: true, _fetchErrorDetail: JSON.stringify(resp).slice(0,300), textCheck: 'fetch_fehlgeschlagen', needsImageBackfill: false } }];\n}\n\nconst liveContentRaw = (resp.content && (resp.content.raw || resp.content.rendered)) || '';\nconst livePlain = stripHtml(liveContentRaw);\nconst expectedPlain = safeStr(ctx.websiteArticle);\nconst canary = expectedPlain.slice(0, 80);\nconst textMatches = canary.length > 0 ? livePlain.includes(canary) : true;\nconst mojibake = hasMojibake(liveContentRaw);\n\nlet textCheck = 'ok';\nif (mojibake) textCheck = 'mojibake_verdacht';\nelse if (!textMatches) textCheck = 'abweichung_verdacht';\n\nconst featuredMedia = Number(resp.featured_media || 0);\nconst hasRealImage = !!safeStr(ctx.imageFinalPath);\nconst needsImageBackfill = hasRealImage && featuredMedia === 0;\n\nreturn [{\n  json: {\n    ...ctx,\n    textCheck,\n    livePlainPreview: livePlain.slice(0, 150),\n    needsImageBackfill,\n    wpFeaturedMediaExisting: featuredMedia\n  }\n}];"
