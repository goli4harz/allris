      "parameters": {
        "jsCode": "if (items.length !== 1) throw new Error(`[Claim] Zustands-Read lieferte ${items.length} Zeilen fuer id ${$('Validiere Claim-Anforderung').item.json.id} - erwartet genau 1, da id Primaerschluessel ist.`);\nconst row = items[0].json || {};\nconst request = $('Validiere Claim-Anforderung').item.json;\nconst now = Date.now();\nconst currentOwner = String(row.claim_owner || '').trim();\nconst currentExpires = Date.parse(String(row.claim_expires_at || ''));\nconst isFree = !currentOwner || !Number.isFinite(currentExpires) || currentExpires <= now;\nconst currentVersion = Number.isFinite(Number(row.claim_version)) ? Number(row.claim_version) : 0;\nreturn [{ json: { ...request, _isFree: isFree, _currentOwner: currentOwner, _currentVersion: currentVersion } }];"
