    {
      "parameters": {
        "jsCode": "// 2026-07-26: Mastodon-Toots wurden vom Nutzer von Hand geloescht (gleicher\n// Grund wie beim WordPress-Reset zuvor) - mastodonPosted stand aber weiter auf\n// true, wodurch P9 diese Zeilen fuer immer als 'schon erledigt' uebersprungen haette.\nfunction truthy(v) { return v === true || v === 'true'; }\nreturn items\n  .filter(i => truthy((i.json||{}).mastodonPosted))\n  .map(i => ({ json: { id: i.json.id, vorgangKey: i.json.vorgangKey, vorgangsnummer: i.json.vorgangsnummer } }));"
      },
