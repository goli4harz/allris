    {
      "id": "n7",
      "name": "Pruefe PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prueft eine einzelne aus Nextcloud geladene Datei auf PDF-Header + %%EOF-Trailer.\nconst j = $json;\nconst binary = $binary || {};\nconst bin = binary.data || {};\nlet ok = false;\nlet reason = '';\nlet size = 0;\n\nlet ziel = {};\ntry { ziel = $('Ziele').item.json || {}; } catch(e) {}\n\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  size = buf.length;\n  const header = buf.subarray(0, 5).toString('latin1');\n  const headerOk = header === '%PDF-';\n  const tail = buf.subarray(Math.max(0, buf.length - 2048)).toString('latin1');\n  const eofOk = tail.includes('%%EOF');\n  ok = headerOk && eofOk && size > 800;\n  if (!headerOk) reason = 'kein %PDF- Header';\n  else if (!eofOk) reason = 'kein %%EOF am Ende (abgeschnitten)';\n  else if (size <= 800) reason = 'zu klein (' + size + ' bytes)';\n} catch (e) {\n  reason = 'Fehler beim Lesen: ' + e.message;\n}\n\nreturn {\n  json: {\n    vorgangsnummer: ziel.vorgangsnummer || '',\n    vorgangKey: ziel.vorgangKey || '',\n    fileName: j.basename || j.name || j.path || '',\n    filePath: j.path || '',\n    size,\n    ok,\n    reason\n  }\n};"
      }
    },
