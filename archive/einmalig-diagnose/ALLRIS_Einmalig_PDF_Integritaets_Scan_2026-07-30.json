      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const j = item.json || {};\n  if (!j.nextcloudFolder) continue;\n  out.push({ json: { vorgangKey: j.vorgangKey, vorgangsnummer: j.vorgangsnummer, nextcloudFolder: j.nextcloudFolder } });\n}\nreturn out;"
      }
