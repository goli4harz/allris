    {
      "parameters": {
        "jsCode": "// 2026-07-26: beide WordPress-Seiten wurden komplett von Hand geleert\n// (golietz.de und die-partei.net/goslar), die Data Table wusste davon nichts -\n// wordpressPosted/wordpressGoslarPosted standen bei allen echten Posts weiter auf\n// true, wodurch P7/P8 die Zeilen fuer immer als 'schon erledigt' uebersprungen\n// haetten. Setzt beide Post-Status-Gruppen zurueck, wo jeweils gesetzt.\nfunction truthy(v) { return v === true || v === 'true'; }\nreturn items\n  .filter(i => truthy((i.json||{}).wordpressPosted) || truthy((i.json||{}).wordpressGoslarPosted))\n  .map(i => ({ json: { id: i.json.id, vorgangKey: i.json.vorgangKey, vorgangsnummer: i.json.vorgangsnummer } }));"
      },
