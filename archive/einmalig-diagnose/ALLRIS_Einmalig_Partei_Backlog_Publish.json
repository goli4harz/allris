      "id": "bklg-0002-4000-8000-000000000002",
      "name": "Hole alle Vorgaenge",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Einmaliger Katch-up 2026-07-28: veroeffentlicht den kompletten Rueckstau bereits fertiger,\n// aber noch nicht veroeffentlichter die-partei.net-Entwuerfe in einem Rutsch (Nutzerwunsch:\n// 'als waeren die schon lange da' -> Datum kommt aus vorlageDatum+3 Tage, aeltestes zuerst,\n// exakt dieselbe Logik wie P8b's normaler 2x/Tag-Betrieb, nur alle auf einmal statt 1 pro Lauf).\n// LIMIT: leer lassen = kompletten Rueckstau nehmen, sonst Zahl eintragen zum Testen.\nconst LIMIT = null;\n\nfunction safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction safeBool(v) { if (v === true) return true; if (typeof v === 'string') return v.trim().toLowerCase() === 'true'; return false; }\nfunction parseDate(v) { const t = Date.parse(safeStr(v)); return Number.isFinite(t) ? t : Infinity; }\n\nconst candidates = items.filter(item => {\n  const j = item.json || {};\n  return safeStr(j.wordpressGoslarDraftId) && !safeBool(j.wordpressGoslarPosted);\n});\n\ncandidates.sort((a, b) => {\n  const ja = a.json || {}, jb = b.json || {};\n  const da = parseDate(ja.vorlageDatum), db = parseDate(jb.vorlageDatum);\n  if (da !== db) return da - db;\n  return parseDate(ja.wordpressGoslarDraftCreatedAt) - parseDate(jb.wordpressGoslarDraftCreatedAt);\n});\n\nconst selected = LIMIT ? candidates.slice(0, LIMIT) : candidates;\nconsole.log(`[Backlog-Publish] ${selected.length} von ${candidates.length} Rueckstau-Kandidaten ausgewaehlt.`);\nreturn selected;"
      },
      "id": "bklg-0003-4000-8000-000000000003",
      "name": "Identifiziere Rueckstau",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "bklg-0004-4000-8000-000000000004",
      "name": "Loop Vorgaenge",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 0]
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst owner = `ALLRIS_Einmalig_Partei_Backlog_Publish:${$execution.id}`;\nreturn items\n  .filter(item => {\n    const j = item.json || {};\n    const oldOwner = String(j.claim_owner || '').trim();\n    const expires = Date.parse(String(j.claim_expires_at || ''));\n    return !oldOwner || !Number.isFinite(expires) || expires <= now;\n  })\n  .map(item => ({ json: {\n    ...item.json,\n    claimAction: 'acquire',\n    claimOwner: owner,\n    claimStage: 'publication_final',\n    leaseMinutes: 30,\n    expectedClaimOwner: item.json.claim_owner ?? null,\n    expectedClaimExpiresAt: item.json.claim_expires_at ?? null\n  } }));"
      },
      "id": "bklg-0005-4000-8000-000000000005",
