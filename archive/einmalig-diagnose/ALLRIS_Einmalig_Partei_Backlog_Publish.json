    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://die-partei.net/goslar/wp-json/wp/v2/posts/' + $json.wordpressGoslarDraftId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wordpressApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'publish', ...($json.vorlageDatum ? { date_gmt: new Date(new Date($json.vorlageDatum).getTime() + 3*24*60*60*1000).toISOString() } : {}) }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "bklg-0008-4000-8000-000000000008",
      "name": "Veroeffentliche Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, -80],
      "retryOnFail": false,
      "credentials": {
        "wordpressApi": { "id": "tzwuM0QBLpYYZfXQ", "name": "DiePARTEI Wordpress" }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst original = $('Nur bestaetigte Claims').itemMatching(idx).json;\nconst resp = $json || {};\nfunction extractErrorText(v) {\n  if (!v) return '';\n  if (typeof v === 'string') return v;\n  if (typeof v === 'object') return String(v.message || v.description || v.error || JSON.stringify(v));\n  return String(v);\n}\nconst postId = resp.id || null;\nconst postLink = resp.link || '';\nconst publishOk = !!postId && resp.status === 'publish';\nconst publishError = publishOk ? '' : (\n  extractErrorText(resp.error) ||\n  extractErrorText(resp.message) ||\n  'Veroeffentlichung fehlgeschlagen (kein publish-Status in Antwort).'\n);\nreturn { json: { ...original, publishedPostId: postId, publishedPostLink: postLink, publishOk, publishError } };"
      },
      "id": "bklg-0009-4000-8000-000000000009",
      "name": "Stelle Kontext nach Veroeffentlichung wieder her",
