{
  "name": "ALLRIS_Einmalig_Depublish_Falsche_Posts",
  "nodes": [
    {
      "parameters": {},
      "id": "depub-0001-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Einmaliger Notfall-Fix 2026-07-28: 8 bereits veroeffentlichte die-partei.net-Posts hatten\n// websiteArticle/instagramCaption mit Inhalt eines ANDEREN Vorgangs (gleiche Ursache wie\n// vol_10731 - KI-Content-Vermischung VOR dem P4 Grounding-Fix von heute Nachmittag). Diese\n// 8 wurden waehrend des WordPress-Backlog-Katch-up mitveroeffentlicht und zeigten dadurch\n// live falsche Inhalte. Setzt jeden Post per PATCH zurueck auf draft und gibt contentStage\n// zur Neugenerierung frei (mit dem jetzt aktiven Pro-Feld-Grounding-Check). Bildfelder bleiben\n// unangetastet - bei allen 8 war ausschliesslich der Text betroffen, die Bilder passten bereits\n// zum jeweils eigenen Vorgang.\nconst TARGETS = [\n  { vorgangKey: 'vol_10706', vorgangsnummer: '2026/179', wordpressGoslarDraftId: '340' },\n  { vorgangKey: 'vol_10641', vorgangsnummer: '2026/136', wordpressGoslarDraftId: '301' },\n  { vorgangKey: 'vol_10646', vorgangsnummer: '2026/141', wordpressGoslarDraftId: '307' },\n  { vorgangKey: 'vol_10640', vorgangsnummer: '2026/135', wordpressGoslarDraftId: '299' },\n  { vorgangKey: 'vol_10707', vorgangsnummer: '2026/180', wordpressGoslarDraftId: '342' },\n  { vorgangKey: 'vol_10639', vorgangsnummer: '2026/117-01', wordpressGoslarDraftId: '305' },\n  { vorgangKey: 'vol_10660', vorgangsnummer: '2026/143-01', wordpressGoslarDraftId: '303' },\n  { vorgangKey: 'vol_10712', vorgangsnummer: '2026/184', wordpressGoslarDraftId: '344' }\n];\nreturn TARGETS.map(t => ({ json: t }));"
      },
      "id": "depub-0002-4000-8000-000000000002",
      "name": "Konfiguriere Ziele",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "depub-0003-4000-8000-000000000003",
      "name": "Loop Vorgaenge",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://die-partei.net/goslar/wp-json/wp/v2/posts/' + $json.wordpressGoslarDraftId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wordpressApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'draft' }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "depub-0004-4000-8000-000000000004",
      "name": "Setze Post auf Entwurf zurueck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -80],
      "retryOnFail": false,
      "credentials": {
        "wordpressApi": { "id": "tzwuM0QBLpYYZfXQ", "name": "DiePARTEI Wordpress" }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst original = $('Loop Vorgaenge').itemMatching(idx).json;\nconst resp = $json || {};\nconst ok = resp.status === 'draft' && !resp.error;\nreturn { json: { ...original, unpublishOk: ok, unpublishError: ok ? '' : String(resp.error?.message || resp.message || JSON.stringify(resp)).slice(0, 500) } };"
      },
      "id": "depub-0005-4000-8000-000000000005",
      "name": "Pruefe Unpublish-Ergebnis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -80]
    },
    {
      "parameters": {
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "hBLqpqeVEojPpOJl",
          "mode": "list",
          "cachedResultName": "allris_vorgaenge"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [{ "keyName": "vorgangKey", "keyValue": "={{ $json.vorgangKey }}" }]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "wordpressGoslarPosted": "={{ false }}",
            "wordpressGoslarPostedAt": "",
            "contentStage": "needs_content",
            "contentErrorReason": "",
            "last_error_code": "",
            "last_error_message": "={{ $json.unpublishOk ? '' : ('Depublish-Fehler: ' + $json.unpublishError) }}",
            "last_error_stage": "",
            "last_error_at": "",
            "next_retry_at": "",
            "retry_count": 0
          },
          "matchingColumns": ["vorgangKey"],
          "schema": []
        },
        "options": {}
      },
      "id": "depub-0006-4000-8000-000000000006",
      "name": "Setze DB-Status zurueck",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1100, -80]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $input.item.json }];"
      },
      "id": "depub-0007-4000-8000-000000000007",
      "name": "Naechster Eintrag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -80]
    }
  ],
  "connections": {
