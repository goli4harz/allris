    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const resp = $input.item.json;\nconst orig = $('IF golietz.de?').item.json;\n\nfunction normDate(v) { return String(v || '').replace(/\\.\\d+Z?$/, '').replace(/Z$/, '').slice(0, 19); }\n\nconst patchOk = !resp.error && !!resp.id;\nconst verifiedDate = resp.date_gmt || '';\nconst verified = patchOk && normDate(verifiedDate) === normDate(orig.targetDate);\n\nlet wasSkipped = false;\ntry { $('PATCH golietz.de Datum').item; } catch(e) { wasSkipped = true; }\nif (wasSkipped) {\n  try { $('PATCH die-partei.net Datum').item; wasSkipped = false; } catch(e2) { wasSkipped = true; }\n}\n\nlet ergebnis;\nif (!patchOk) {\n  ergebnis = 'FEHLER (GET/Verify): ' + (resp.error?.message || resp.message || JSON.stringify(resp).slice(0, 200));\n} else if (wasSkipped) {\n  ergebnis = 'UEBERSPRUNGEN - date_gmt war schon korrekt (' + verifiedDate + ')';\n} else if (!verified) {\n  ergebnis = 'WARNUNG: Post geladen, aber date_gmt weicht ab - erwartet ' + orig.targetDate + ', gefunden ' + verifiedDate;\n} else {\n  ergebnis = 'OK - gepatcht und geprueft, date_gmt = ' + verifiedDate;\n}\n\nreturn { json: {\n  vorgangKey: orig.vorgangKey,\n  site: orig.site,\n  postId: orig.postId,\n  targetDate: orig.targetDate,\n  verifiedDate,\n  verified,\n  skipped: wasSkipped,\n  ergebnis\n} };"
      },
