    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Einmaliger Nachtrag 2026-07-28: setzt bei bereits veroeffentlichten WordPress-Posts\n// (golietz.de = P7, die-partei.net/goslar = P8b) das angezeigte Datum rueckwirkend\n// auf vorlageDatum + 3 Tage, analog zur neuen Standardlogik in P7/P8b selbst.\n// Ein Vorgang kann auf beiden Seiten gepostet sein -> bis zu 2 Ausgabe-Items pro Zeile.\n\nfunction safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction safeBool(v) {\n  if (v === true) return true;\n  if (typeof v === 'string') return v.trim().toLowerCase() === 'true';\n  return false;\n}\nfunction targetDateIso(vorlageDatum) {\n  const t = Date.parse(safeStr(vorlageDatum));\n  if (!Number.isFinite(t)) return null;\n  return new Date(t + 3 * 24 * 60 * 60 * 1000).toISOString();\n}\n\nconst out = [];\nfor (const item of items) {\n  const j = item.json || {};\n  const vorlageDatum = safeStr(j.vorlageDatum);\n  if (!vorlageDatum) continue;\n  const targetDate = targetDateIso(vorlageDatum);\n  if (!targetDate) continue;\n\n  if (safeBool(j.wordpressPosted) && safeStr(j.wordpressPostId)) {\n    out.push({ json: { vorgangKey: j.vorgangKey, site: 'golietz', postId: safeStr(j.wordpressPostId), targetDate } });\n  }\n  if (safeBool(j.wordpressGoslarPosted) && safeStr(j.wordpressGoslarPostId)) {\n    out.push({ json: { vorgangKey: j.vorgangKey, site: 'diepartei', postId: safeStr(j.wordpressGoslarPostId), targetDate } });\n  }\n}\nreturn out;"
      },
