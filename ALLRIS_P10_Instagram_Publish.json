        "jsCode": "const idx = $itemIndex;\nconst original = $('Baue Instagram-Caption').itemMatching(idx).json;\nconst shareResult = $json || {};\n// FIX 2026-08-26: WordPress-Medien-Upload ist aktuell serverseitig blockiert (rest_upload_sideload_error).\n// Instagram braucht zwingend eine oeffentliche Bild-URL (kein Binaer-Upload moeglich, anders als\n// Facebook/Mastodon) - deshalb NextCloud-Freigabelink statt wordpressGoslarImageUrl. '/download'\n// liefert die Datei direkt (Content-Type: image/png), nicht nur die Vorschauseite - live verifiziert.\nconst shareUrl = shareResult && shareResult.url ? String(shareResult.url) : '';\nconst instagramImageUrl = shareUrl ? (shareUrl + '/download') : (original.wordpressGoslarImageUrl || '');\nreturn { json: { ...original, instagramImageUrl } };"
