    },
    {
      "parameters": {
        "jsCode": "// Nutzerentscheidung 2026-08-30 (analog P11 Facebook / P9 Mastodon): aufsteigende\n// Brisanz zum 13.09. (Kommunalwahl) - niedrige/mittlere Brisanz zuerst posten, die\n// brisantesten Themen fuer die letzten Tage vor der Wahl aufsparen (Recency-Effekt).\n// Kapazitaet (7 Laeufe/Tag, siehe Schedule Trigger) ist bewusst so bemessen, dass der\n// Rueckstand (58, Stand 30.08.) bis zum 12.09. komplett abgearbeitet wird. Die\n// eigentliche 1-Post-pro-Lauf-Begrenzung passiert weiterhin im separaten Node\n// \"Begrenze auf 1 Post pro Lauf\" - diese Sortierung bestimmt nur die Reihenfolge.\n// combinedScore kombiniert kommunikationspotenzial (0-8, von P3) mit sprengstoff\n// (KEINER/GERING/MITTEL/HOCH, x3 gewichtet). Alter bleibt nur noch Tie-Breaker\n// innerhalb gleicher Scores.\n// ACHTUNG: nach dem 13.09. neu bewerten - reine Score-Sortierung ohne Alters-Schutz\n// kann im Dauerbetrieb niedrig bewertete Vorgaenge unbegrenzt liegen lassen.\nfunction safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction safeNum(v) { const n = Number(v); return isNaN(n) ? 0 : n; }\nconst SPRENGSTOFF_WEIGHT = { KEINER: 0, GERING: 1, MITTEL: 2, HOCH: 3 };\nfunction combinedScore(j) {\n  const kompot = safeNum(j.kommunikationspotenzial);\n  const sprengstoff = SPRENGSTOFF_WEIGHT[safeStr(j.sprengstoff).toUpperCase()] || 0;\n  return kompot + sprengstoff * 3;\n}\nreturn [...items].sort((a, b) => {\n  const sa = combinedScore(a.json), sb = combinedScore(b.json);\n  if (sa !== sb) return sa - sb;\n  const ta = Date.parse(a.json.lastAnalysisAt || '') || 0;\n  const tb = Date.parse(b.json.lastAnalysisAt || '') || 0;\n  return ta - tb;\n});\n"
      },
