    {
      "parameters": {
        "jsCode": "function safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction safeBool(v) {\n  if (v === true) return true;\n  if (typeof v === 'string') return v.trim().toLowerCase() === 'true';\n  return false;\n}\nconst items = $input.all();\nreturn items.filter(item => {\n  const j = item.json || {};\n  // Gleiche Kohorte wie P8/P9: nur satiretaugliche Vorgaenge mit echtem Instagram-Text.\n  if (safeStr(j.sharepicNeedStage) !== 'topic_ok') return false;\n  if (!safeStr(j.instagramCaption)) return false;\n  if (safeBool(j.instagramPosted)) return false;\n  if (!safeStr(j.vorgangKey)) return false;\n  // Instagram-Feedposts brauchen zwingend ein Bild - anders als Mastodon kein Text-only-Fallback.\n  // Die oeffentliche Bild-URL kommt von P8 (WordPress-Medienbibliothek), also muss P8 fertig sein\n  // UND tatsaechlich ein Bild hochgeladen haben (nur der Fall, wenn P6 vorher erfolgreich war).\n  if (!safeBool(j.wordpressGoslarPosted)) return false;\n  // FIX 2026-08-26 (Nutzerwunsch): WordPress-Medien-Upload aktuell serverseitig blockiert -\n  // Instagram entkoppelt sich davon und nutzt stattdessen einen NextCloud-Freigabelink\n  // (siehe 'NC Erstelle Public Share' Node) auf Basis von imageFinalPath.\n  if (!safeStr(j.imageFinalPath)) return false;\n  return true;\n});"
      },
      "id": "fa10b001-0000-4000-9000-000000000003",
      "name": "Filter Instagram-Kandidaten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
