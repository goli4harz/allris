    {
      "parameters": {
        "jsCode": "function safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction parseArr(v) {\n  try { const a = JSON.parse(v); return Array.isArray(a) ? a : []; } catch (e) { return []; }\n}\nfunction sanitizeTag(t) {\n  return safeStr(t).replace(/^#/, '').replace(/[^\\p{L}\\p{N}_]/gu, '');\n}\n// Instagram-Captions: 2200 Zeichen Limit, bis zu 30 Hashtags erlaubt.\nconst INSTAGRAM_CHAR_LIMIT = 2200;\nconst FIXED_HASHTAGS = ['meingoslar', 'goslar', 'unserklüngelkannmehr', 'prioritätenproblem'];\n\nconst j = $json;\nconst caption = safeStr(j.instagramCaption);\n\n// FIX 2026-08-26 (Nutzerfeedback: Post ohne Link zum Webseiten-Artikel): Links in Instagram-\n// Captions sind zwar nicht klickbar, aber als Klartext trotzdem sichtbar/kopierbar - gleiches\n// Muster wie P9 Mastodon (wordpressGoslarPostLink, immer vorhanden sobald wordpressGoslarPosted\n// true ist, was der Filter bereits voraussetzt).\nconst postLink = safeStr(j.wordpressGoslarPostLink);\n\nconst rawTags = parseArr(j.instagramHashtags).length ? parseArr(j.instagramHashtags) : parseArr(j.facebookHashtags);\nconst sanitized = rawTags.map(sanitizeTag).filter(Boolean);\nconst seen = new Set();\nconst tags = [];\nfor (const t of [...sanitized, ...FIXED_HASHTAGS]) {\n  const key = t.toLowerCase();\n  if (seen.has(key)) continue;\n  seen.add(key);\n  tags.push('#' + t);\n}\nconst hashtagLine = tags.join(' ');\n\nconst hashtagReserve = hashtagLine ? (2 + hashtagLine.length) : 0;\nconst linkReserve = postLink ? (2 + postLink.length) : 0;\nconst bodyLimit = Math.max(0, INSTAGRAM_CHAR_LIMIT - hashtagReserve - linkReserve);\n\nlet body = caption;\nif (body.length > bodyLimit) {\n  const cut = body.slice(0, Math.max(0, bodyLimit - 1));\n  const lastBreak = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));\n  body = (lastBreak > bodyLimit * 0.5 ? cut.slice(0, lastBreak + 1) : cut) + '…';\n}\n\nlet instagramCaptionFinal = body;\nif (postLink) instagramCaptionFinal += '\\n\\n' + postLink;\nif (hashtagLine) instagramCaptionFinal += '\\n\\n' + hashtagLine;\n\nreturn { json: { ...j, instagramCaptionFinal } };"
      },
