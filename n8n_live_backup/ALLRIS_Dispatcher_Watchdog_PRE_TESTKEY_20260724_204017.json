                      "id":  "a1b2c3d4-2222-4a2b-8c3d-000000000002",
                      "name":  "Hole alle Vorgaenge",
                      "type":  "n8n-nodes-base.dataTable",
                      "typeVersion":  1.1,
                      "position":  [
                                       512,
                                       272
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// ============================================================\n// DISPATCHER-WATCHDOG (Paket 7, Architekturpruefung 2026-07-22)\n// ============================================================\n// Reiner Lese-/Alarm-Workflow: schreibt NICHTS in allris_vorgaenge, ruft\n// keinen anderen Workflow aktiv auf. Findet Vorgaenge, die laenger als\n// STALE_HOURS in einem Zwischenzustand haengen, obwohl die naechste Stufe\n// sie laengst haette abholen muessen (die 5h-Kaskade laeuft mehrfach in\n// dieser Zeit). Nutzt ausschliesslich bereits vorhandene Felder - keine\n// Abhaengigkeit von Paket 2 (State-History/Fehlercodes), die noch nicht\n// angelegt sind.\n//\n// Ergaenzt (nicht ersetzt) die stufeneigenen Selbstheilungs-/Alert-Pfade,\n// die es schon gibt (z.B. P4s Blockade-Alert, P2s archiving_failed-Alert,\n// P5bs Erinnerungen) - diese pruefen jeweils nur ihre eigene Stufe. Dieser\n// Workflow schaut stufenuebergreifend auf \"haette laengst weiter sein\n// muessen, ist es aber nicht\".\n//\n// Absichtlich sehr konservativ gehalten: nur 4 klar begruendbare Checks,\n// grosszuegige Schwellwerte (24h = ca. 5 verpasste Kaskaden-Durchlaeufe),\n// um Fehlalarme durch normale Laufzeitschwankungen (siehe bekanntes\n// Proxy-Langsamkeits-Thema) zu vermeiden.\n\nconst STALE_HOURS = 6;\nconst STALE_MS = STALE_HOURS * 60 * 60 * 1000;\n\nfunction safeStr(v) { return v === null || v === undefined ? \u0027\u0027 : String(v).trim(); }\nfunction ageMs(iso) {\n  if (!iso) return null;\n  const t = Date.parse(iso);\n  return Number.isFinite(t) ? (Date.now() - t) : null;\n}\nfunction isStale(iso) {\n  const a = ageMs(iso);\n  return a !== null \u0026\u0026 a \u003e STALE_MS;\n}\n\nconst rows = $input.all().map(i =\u003e i.json || {});\nconst findings = [];\n\nfor (const j of rows) {\n  const vorgangKey = safeStr(j.vorgangKey);\n  if (!vorgangKey) continue;\n  const label = safeStr(j.vorgangsnummer) + \u0027 – \u0027 + safeStr(j.title);\n\n  // Check 1: seit Ingestion laenger als STALE_HOURS bei needs_summary haengen\n  // geblieben (P3 haette es laengst zusammengefasst haben muessen).\n  if (safeStr(j.contentStage) === \u0027needs_summary\u0027 \u0026\u0026 isStale(j.firstseen)) {\n    findings.push({\n      vorgangKey, label,\n      check: \u0027ingestion_to_summary\u0027,\n      hint: \u0027contentStage=needs_summary seit über \u0027 + STALE_HOURS + \u0027h (firstseen=\u0027 + safeStr(j.firstseen) + \u0027) - Bewertung (P3) hat es nicht abgeholt.\u0027\n    });\n  }\n\n  // Check 2: needs_content, aber Agenten-Kette (P3d) ist nie gelaufen.\n  if (safeStr(j.contentStage) === \u0027needs_content\u0027 \u0026\u0026\n      !safeStr(j.judgmentChainProcessedAt) \u0026\u0026\n      isStale(j.lastAnalysisAt)) {\n    findings.push({\n      vorgangKey, label,\n      check: \u0027analysis_to_judgment\u0027,\n      hint: \u0027lastAnalysisAt seit über \u0027 + STALE_HOURS + \u0027h gesetzt, aber judgmentChainProcessedAt fehlt weiterhin - Agenten-Kette (P3d) hat es nicht abgeholt.\u0027\n    });\n  }\n\n  // Check 3: Eignungs-Agent hat Sharepic freigegeben, aber Kernbotschaft\n  // (P3e) hat nie eine Auswahl angestossen.\n  if (safeStr(j.sharepicNeedStage) === \u0027topic_ok\u0027 \u0026\u0026\n      !safeStr(j.headlineChoiceStage) \u0026\u0026\n      isStale(j.lastAnalysisAt)) {\n    findings.push({\n      vorgangKey, label,\n      check: \u0027judgment_to_kernbotschaft\u0027,\n      hint: \u0027sharepicNeedStage=topic_ok seit über \u0027 + STALE_HOURS + \u0027h, aber headlineChoiceStage ist weiterhin leer - Kernbotschaft-Stufe (P3e) hat es nicht abgeholt.\u0027\n    });\n  }\n\n  // Check 4: Bildprompt fertig, aber Bildgenerierung (P6) hat nie begonnen.\n  if (safeStr(j.visualPromptStage) === \u0027prompt_ready\u0027 \u0026\u0026\n      [\u0027\u0027, \u0027not_started\u0027].includes(safeStr(j.imageStage)) \u0026\u0026\n      isStale(j.lastAnalysisAt)) {\n    findings.push({\n      vorgangKey, label,\n      check: \u0027visual_to_image\u0027,\n      hint: \u0027visualPromptStage=prompt_ready seit über \u0027 + STALE_HOURS + \u0027h, aber imageStage=\u0027 + (safeStr(j.imageStage) || \u0027(leer)\u0027) + \u0027 - Bildgenerierung (P6) hat es nicht abgeholt.\u0027\n    });\n  }\n}\n\nreturn findings.map(f =\u003e ({ json: f }));\n"
                                     },
                      "id":  "a1b2c3d4-3333-4a2b-8c3d-000000000003",
                      "name":  "Dispatcher-Watchdog",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       768,
                                       272
                                   ],
                      "notes":  "Reine Leseoperation. Schreibt nichts, ruft keinen anderen Workflow auf. Siehe Kommentar im Code fuer die 4 Checks und die Schwellwert-Begruendung."
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Baut eine Matrix-Sammelmeldung aus allen Dispatcher-Funden. Reine\n// Lesestufe - kein DB-Write, kein erneuter Versuch, wenn schon einmal\n// gemeldet (bewusst: der Mensch soll das manuell pruefen und die Ursache\n// beheben, nicht der Dispatcher automatisch loesen - siehe Notiz im Watchdog-\n// Node). Wiederholt sich daher bei jedem Lauf, solange der Zustand anhaelt -\n// akzeptabel bei einem 6-Stunden-Intervall.\nfunction safeStr(v) { return v === null || v === undefined ? \u0027\u0027 : String(v).trim(); }\n\nif (!items || items.length === 0) {\n  return [];\n}\n\nconst byCheck = {};\nfor (const item of items) {\n  const j = item.json || {};\n  const check = safeStr(j.check) || \u0027unbekannt\u0027;\n  if (!byCheck[check]) byCheck[check] = [];\n  byCheck[check].push(j);\n}\n\nconst CHECK_LABELS = {\n  ingestion_to_summary: \u0027Bewertung (P3) nicht abgeholt\u0027,\n  analysis_to_judgment: \u0027Agenten-Kette (P3d) nicht abgeholt\u0027,\n  judgment_to_kernbotschaft: \u0027Kernbotschaft (P3e) nicht abgeholt\u0027,\n  visual_to_image: \u0027Bildgenerierung (P6) nicht abgeholt\u0027\n};\n\nlet sections = [];\nfor (const [check, list] of Object.entries(byCheck)) {\n  const label = CHECK_LABELS[check] || check;\n  const zeilen = list.map(j =\u003e `• ${safeStr(j.label) || \u0027?\u0027}\\n  ${safeStr(j.hint)}`);\n  sections.push(`— ${label} (${list.length}) —\\n\\n` + zeilen.join(\u0027\\n\\n\u0027));\n}\n\nconst msg = `🕵️ Dispatcher-Watchdog: ${items.length} liegen gebliebene Vorgänge gefunden\\n\\n` +\n  `Diese Vorgänge haetten laengst von der naechsten Pipeline-Stufe abgeholt ` +\n  `werden muessen. Dies ist ein reiner Beobachtungs-Alarm (Paket 7) - es wurde ` +\n  `nichts automatisch veraendert:\\n\\n` +\n  sections.join(\u0027\\n\\n\u0027);\n\nconst txnId = \u0027dispatch_\u0027 + Date.now();\n\nreturn [{ json: { alertMessage: msg, txnId, findingCount: items.length } }];\n"
                                     },
