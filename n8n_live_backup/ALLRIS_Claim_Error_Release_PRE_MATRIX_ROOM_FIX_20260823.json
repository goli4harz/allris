      ],
      "parameters": {
        "jsCode": "// Shared Error-Workflow (2026-07-30): wird per settings.errorWorkflow an alle\n// Claim-nutzenden Pipeline-Workflows gehaengt. Findet bei JEDEM unbehandelten\n// Crash (nicht nur bekannten onError-Luecken wie beim P8-Bildladen-Bug) die\n// Claims der gecrashten Execution ueber claim_owner = \"<WorkflowName>:<executionId>\"\n// und gibt sie sofort frei, statt auf den 30-Minuten-Lease-Ablauf zu warten.\nconst j = $json || {};\nconst workflowName = (j.workflow && j.workflow.name) || 'UNBEKANNT';\nconst executionId = (j.execution && j.execution.id) || '';\nconst errorMessage = (j.execution && j.execution.error && j.execution.error.message) || '';\nconst lastNode = (j.execution && j.execution.lastNodeExecuted) || '';\nconst ownerString = `${workflowName}:${executionId}`;\nconst txnId = 'claimrelease-' + Date.now() + '-' + Math.random().toString(36).slice(2);\nconst alertMessage = `⚠️ ALLRIS Claim-Auto-Release: ${workflowName} (Execution ${executionId}) ist gecrasht`\n  + (lastNode ? ` bei \"${lastNode}\"` : '')\n  + (errorMessage ? `: ${errorMessage}` : '')\n  + '. Offene Claims dieser Execution wurden automatisch freigegeben (falls vorhanden).';\nreturn { json: { ownerString, workflowName, executionId, errorMessage, lastNode, txnId, alertMessage } };"
      }
    },
    {
