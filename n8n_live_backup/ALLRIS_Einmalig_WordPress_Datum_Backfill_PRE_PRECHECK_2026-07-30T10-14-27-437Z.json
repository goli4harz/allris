    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WICHTIG: die PATCH-HTTP-Nodes liefern die WordPress-Antwort zurueck (bzw. bei Fehler\n// ein error-Objekt) - beides ohne vorgangKey/site/postId/targetDate. Der urspruengliche\n// Kontext wird deshalb bewusst ueber die vorgelagerte IF-Node wiederhergestellt, statt\n// sich auf $input zu verlassen (gleiche Klasse von Bug wie an mehreren anderen Stellen\n// in P4/P1 diese Session - siehe allris_p4_claim_release_gap_2026-07-28).\n//\n// Nachtrag 2026-07-30: verifiziert jetzt zusaetzlich per GET, ob date_gmt tatsaechlich\n// gesetzt wurde, statt nur der PATCH-Antwort zu vertrauen (die bei einer teilweise\n// erfolgreichen, aber timeout-abgebrochenen Verbindung trotzdem 200 zurueckgeben kann).\nconst resp = $input.item.json;\nconst orig = $('IF golietz.de?').item.json;\n\nfunction normDate(v) {\n  return String(v || '').replace(/\\.\\d+Z?$/, '').replace(/Z$/, '').slice(0, 19);\n}\n\nconst patchOk = !resp.error && !!resp.id;\nconst verifiedDate = resp.date_gmt || '';\nconst verified = patchOk && normDate(verifiedDate) === normDate(orig.targetDate);\n\nlet ergebnis;\nif (!patchOk) {\n  ergebnis = 'FEHLER (GET/Verify): ' + (resp.error?.message || resp.message || JSON.stringify(resp).slice(0, 200));\n} else if (!verified) {\n  ergebnis = 'WARNUNG: Post geladen, aber date_gmt weicht ab - erwartet ' + orig.targetDate + ', gefunden ' + verifiedDate;\n} else {\n  ergebnis = 'OK - geprueft, date_gmt = ' + verifiedDate;\n}\n\nreturn { json: {\n  vorgangKey: orig.vorgangKey,\n  site: orig.site,\n  postId: orig.postId,\n  targetDate: orig.targetDate,\n  verifiedDate,\n  verified,\n  ergebnis\n} };"
      },
