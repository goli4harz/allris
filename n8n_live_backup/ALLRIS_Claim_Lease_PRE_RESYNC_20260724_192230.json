                  {
                      "parameters":  {
                                         "jsCode":  "const j = $json || {};\nif (j.claimAction !== \u0027acquire\u0027) throw new Error(\u0027[Claim] claimAction muss acquire oder release sein.\u0027);\nif (!String(j.vorgangKey || \u0027\u0027).trim()) throw new Error(\u0027[Claim] vorgangKey fehlt.\u0027);\nif (!String(j.claimOwner || \u0027\u0027).trim()) throw new Error(\u0027[Claim] claimOwner fehlt.\u0027);\nif (!String(j.claimStage || \u0027\u0027).trim()) throw new Error(\u0027[Claim] claimStage fehlt.\u0027);\nconst minutes = Math.max(1, Math.min(120, Number(j.leaseMinutes || 30)));\nreturn [{ json: { ...j, leaseMinutes: minutes, claimAcquiredAt: $now.toISO(), claimExpiresAt: $now.plus({ minutes }).toISO() } }];",
