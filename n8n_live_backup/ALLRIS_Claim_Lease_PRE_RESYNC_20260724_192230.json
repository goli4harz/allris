                  {
                      "parameters":  {
                                         "jsCode":  "const rows = items.map(item =\u003e item.json || {});\nconst requests = $(\u0027Validiere Claim-Anforderung\u0027).all().map(item =\u003e item.json || {});\nconst rowsByKey = new Map();\nfor (const row of rows) {\n  const key = String(row.vorgangKey || \u0027\u0027).trim();\n  if (key \u0026\u0026 !rowsByKey.has(key)) rowsByKey.set(key, row);\n}\nreturn requests.map(request =\u003e {\n  const key = String(request.vorgangKey || \u0027\u0027).trim();\n  const row = rowsByKey.get(key) || { vorgangKey: key };\n  const acquired = String(row.claim_owner || \u0027\u0027) === String(request.claimOwner || \u0027\u0027);\n  return { json: { ...row, claimAcquired: acquired, requestedClaimOwner: request.claimOwner } };\n});"
                                     },
