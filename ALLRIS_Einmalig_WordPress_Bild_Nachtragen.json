      "parameters": {
        "jsCode": "const original = $('Konfiguriere Ziel').item.json;\nconst uploadResult = $json;\nfunction extractErrorText(v) {\n  if (!v) return '';\n  if (typeof v === 'string') return v;\n  if (typeof v === 'object') return String(v.message || v.description || v.error || JSON.stringify(v));\n  return String(v);\n}\nconst mediaId = uploadResult && uploadResult.id ? uploadResult.id : null;\nconst mediaUrl = uploadResult && uploadResult.source_url ? uploadResult.source_url : null;\nif (!mediaId) {\n  throw new Error('Medien-Upload fehlgeschlagen: ' + (extractErrorText(uploadResult && uploadResult.error) || extractErrorText(uploadResult && uploadResult.message) || 'keine Media-ID erhalten'));\n}\nreturn [{ json: { ...original, wpFeaturedMediaId: mediaId, wpFeaturedMediaUrl: mediaUrl } }];"
      },
