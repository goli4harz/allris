      "parameters": {
        "jsCode": "// Traegt hier das eine Ziel ein, dessen Bild nachtraeglich auf die\n// Partei-Webseite hochgeladen und als Featured Image gesetzt werden soll.\n// Grund: P8 hat keine Update-Logik fuer bereits existierende Posts (Slug-Suche\n// dient nur als Duplikat-Schutz) - ein erneuter P8-Lauf haette hier nichts bewirkt.\nconst TARGET = {\n  vorgangKey: 'vol_10583',\n  vorgangsnummer: '2026/100',\n  wordpressGoslarPostId: 262,\n  imageFinalPath: '/DiePARTEI/Allris/2026/vol_10583_2026_100_-_Vorlage_-_Investitionszuschuss_an_den_Ev.-luth._Propsteiverband_Braun/02_reaktion/Instagram/final_vol_10583.png'\n};\nreturn [{ json: TARGET }];"
      },
