    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst original = $('Nur bestaetigte Claims').itemMatching(idx).json;\nconst resp = $json || {};\nfunction extractErrorText(v) {\n  if (!v) return '';\n  if (typeof v === 'string') return v;\n  if (typeof v === 'object') return String(v.message || v.description || v.error || JSON.stringify(v));\n  return String(v);\n}\nconst postId = resp.id || null;\nconst postLink = resp.link || '';\nconst publishOk = !!postId && resp.status === 'publish';\nconst publishError = publishOk ? '' : (\n  extractErrorText(resp.error) ||\n  extractErrorText(resp.message) ||\n  'Veroeffentlichung fehlgeschlagen (kein publish-Status in Antwort).'\n);\nreturn { json: { ...original, publishedPostId: postId, publishedPostLink: postLink, publishOk, publishError } };"
      },
