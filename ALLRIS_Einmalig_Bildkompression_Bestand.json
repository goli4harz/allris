    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst prev = $('Berechne neuen Pfad').itemMatching(idx).json;\nconst uploadResult = $input.item.json || {};\nconst uploadError = uploadResult.error || uploadResult.Error || null;\nconst ok = !uploadError;\nreturn [{ json: { ...prev, _migrationOk: ok, _migrationError: ok ? '' : String(uploadError) } }];"
      },
