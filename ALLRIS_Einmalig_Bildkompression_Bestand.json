      "id": "einmalig-imgcomp-001-000000000002",
      "name": "Hole alle Vorgaenge",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [224, 0]
    },
    {
      "parameters": {
        "jsCode": "// Nur bereits fertig komponierte Bilder (imageStage=composed) mit noch\n// unkomprimiertem PNG als imageFinalPath - bereits migrierte (.jpg) oder\n// noch nicht fertige Zeilen werden uebersprungen. Original wird pro Zeile\n// explizit als _orig.png gesichert (Nutzerwunsch, NextCloud-Speicher ist\n// kein Engpass) - gleiche Konvention wie im laufenden P6-Pipeline-Fix.\nfunction safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nconst items = $input.all();\nreturn items.filter(item => {\n  const j = item.json || {};\n  if (safeStr(j.imageStage) !== 'composed') return false;\n  if (!/\\.png$/i.test(safeStr(j.imageFinalPath))) return false;\n  if (!safeStr(j.vorgangKey)) return false;\n  return true;\n});"
      },
      "id": "einmalig-imgcomp-001-000000000003",
      "name": "Filter Migrations-Kandidaten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0]
    },
    {
      "parameters": { "options": {} },
      "id": "einmalig-imgcomp-001-000000000004",
      "name": "Loop Vorgaenge",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [672, 0]
    },
    {
      "parameters": {
        "operation": "download",
        "path": "={{ $json.imageFinalPath }}"
      },
      "id": "einmalig-imgcomp-001-000000000005",
      "name": "NC Lade Original",
      "type": "n8n-nodes-base.nextCloud",
      "typeVersion": 1,
      "position": [896, -96],
      "credentials": {
        "nextCloudApi": {
          "id": "jlZlwASXZbJyNpfA",
          "name": "NextCloud account"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst ctx = $('Loop Vorgaenge').itemMatching(idx).json;\nconst downloadResult = $input.item;\nconst hasImage = !!(downloadResult.binary && downloadResult.binary.data);\nreturn [{\n  json: { ...ctx, _downloadOk: hasImage, _downloadError: hasImage ? '' : String((downloadResult.json && downloadResult.json.error) || 'Download fehlgeschlagen') },\n  binary: hasImage ? { data: downloadResult.binary.data } : {}\n}];"
      },
      "id": "einmalig-imgcomp-001-000000000006",
      "name": "Pruefe Download",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, -96]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json._downloadOk }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "einmalig-imgcomp-001-000000000007",
      "name": "IF Download ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1344, -96]
    },
    {
      "parameters": {
        "operation": "upload",
        "path": "={{ $json.imageFinalPath.replace(/\\.png$/i, '_orig.png') }}",
        "binaryDataUpload": true,
        "binaryPropertyName": "data"
      },
      "id": "einmalig-imgcomp-001-000000000017",
      "name": "NC Sichere Original (_orig)",
      "type": "n8n-nodes-base.nextCloud",
      "typeVersion": 1,
      "position": [1568, -96],
      "credentials": {
        "nextCloudApi": {
          "id": "jlZlwASXZbJyNpfA",
          "name": "NextCloud account"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst prev = $('Pruefe Download').itemMatching(idx);\nreturn [{ json: { ...prev.json }, binary: { data: prev.binary.data } }];"
      },
      "id": "einmalig-imgcomp-001-000000000018",
      "name": "Stelle Kontext nach Original-Backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, -96]
    },
    {
      "parameters": {
        "operation": "information",
        "dataPropertyName": "data"
      },
      "id": "einmalig-imgcomp-001-000000000008",
      "name": "Lies Masse",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [1792, -160]
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst prev = $('Stelle Kontext nach Original-Backup').itemMatching(idx).json;\nreturn [{ json: { ...prev, _size: $json.size }, binary: $input.item.binary }];"
      },
      "id": "einmalig-imgcomp-001-000000000009",
      "name": "Kontext nach Masse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1792, -160]
    },
    {
      "parameters": {
        "operation": "resize",
        "dataPropertyName": "data",
        "width": "={{ Number($json._size.width) }}",
        "height": "={{ Number($json._size.height) }}",
        "resizeOption": "ignoreAspectRatio",
        "options": { "format": "jpeg", "quality": 82 }
      },
      "id": "einmalig-imgcomp-001-000000000010",
      "name": "Komprimiere",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [2016, -160]
    },
    {
      "parameters": {
        "jsCode": "const idx = $itemIndex;\nconst prev = $('Kontext nach Masse').itemMatching(idx).json;\nconst oldPath = String(prev.imageFinalPath || '');\nconst newPath = oldPath.replace(/\\.png$/i, '.jpg');\nconst bin = $input.item.binary.data;\nbin.fileName = (bin.fileName || 'image').replace(/\\.png$/i, '.jpg');\nbin.fileExtension = 'jpg';\nbin.mimeType = 'image/jpeg';\nreturn [{ json: { ...prev, imageFinalPathNeu: newPath }, binary: { data: bin } }];"
      },
      "id": "einmalig-imgcomp-001-000000000011",
      "name": "Berechne neuen Pfad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, -160]
    },
