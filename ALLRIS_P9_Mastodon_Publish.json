    {
      "parameters": {
        "jsCode": "function safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction safeBool(v) {\n  if (v === true) return true;\n  if (typeof v === 'string') return v.trim().toLowerCase() === 'true';\n  return false;\n}\nconst items = $input.all();\nreturn items.filter(item => {\n  const j = item.json || {};\n  // Gleiche Kohorte wie ALLRIS_P8_Partei_Webseite: nur satiretaugliche Vorgaenge\n  // (sharepicNeedStage=topic_ok), erst wenn P4 echten Satire-Content erzeugt hat.\n  // instagramCaption direkt geprueft (der tatsaechlich gepostete Text), nicht nur\n  // contentStage - selbe Lehre wie aus dem P7-Wettlauf-Bug vom selben Tag: nur ein\n  // echtes Content-Feld ist ein verlaessliches Gate, kein Status-Enum.\n  if (safeStr(j.sharepicNeedStage) !== 'topic_ok') return false;\n  if (!safeStr(j.instagramCaption)) return false;\n  if (safeBool(j.mastodonPosted)) return false;\n  if (!safeStr(j.vorgangKey)) return false;\n  // FIX 2026-07-25 (Nutzerfund): P9 lief vor P6 (Bildgenerierung) her - Vorgaenge mit\n  // sharepicNeedStage=topic_ok wollen IMMER ein Bild, wurden aber schon text-only gepostet,\n  // bevor das Bild fertig war (mastodonPosted=true verhindert seither jede Nachbesserung).\n  // Exakt dasselbe Wettlauf-Muster wie P7 vs. P4 vom selben Tag, hier P9 vs. P6. Nur bei\n  // 'topic_error_final' (Bildkonzept endgueltig gescheitert) wird bewusst text-only gepostet,\n  // sonst wird auf das Bild gewartet.\n  const hasImage = !!safeStr(j.imageFinalPath);\n  const imageGivenUp = safeStr(j.imageStage) === 'topic_error_final';\n  const waitingForImage = !hasImage && !imageGivenUp;\n  if (waitingForImage) return false;\n  return true;\n});"
      },
