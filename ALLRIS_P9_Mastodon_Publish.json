    {
      "parameters": {
        "jsCode": "function safeStr(v) { return v === null || v === undefined ? '' : String(v).trim(); }\nfunction parseArr(v) {\n  try { const a = JSON.parse(v); return Array.isArray(a) ? a : []; } catch (e) { return []; }\n}\nfunction sanitizeTag(t) {\n  return safeStr(t).replace(/^#/, '').replace(/[^\\p{L}\\p{N}_]/gu, '');\n}\n// Vorlaeufiger Wert, sobald die Ziel-Mastodon-Instanz feststeht ggf. anpassen\n// (Standard-Limit vieler Instanzen ist 500 Zeichen, manche erlauben mehr).\nconst MASTODON_CHAR_LIMIT = 500;\n// Nutzerwunsch 2026-07-25: feste Pflicht-Hashtags, unabhaengig von den KI-generierten -\n// stehen am ENDE der Hashtag-Zeile (themenspezifische zuerst, Standard-Tags zuletzt),\n// dedupliziert falls die KI sie zufaellig auch vorschlaegt.\nconst FIXED_HASHTAGS = ['meingoslar', 'goslar'];\n\nconst j = $json;\nconst caption = safeStr(j.instagramCaption) || safeStr(j.facebookPost);\n\n// FIX 2026-07-25 (Nutzerwunsch): P4 erzeugt bereits lokal/thematisch passende Hashtags\n// (instagramHashtags, 5-12 Stueck), die P9 bisher nie verwendet hat - Toots gingen komplett\n// ohne Hashtags raus. facebookHashtags (2-4, konservativer) als Fallback.\nconst rawTags = parseArr(j.instagramHashtags).length ? parseArr(j.instagramHashtags) : parseArr(j.facebookHashtags);\nconst sanitized = rawTags.map(sanitizeTag).filter(Boolean);\nconst seen = new Set();\nconst tags = [];\nfor (const t of [...sanitized, ...FIXED_HASHTAGS]) {\n  const key = t.toLowerCase();\n  if (seen.has(key)) continue;\n  seen.add(key);\n  tags.push('#' + t);\n}\nconst hashtagLine = tags.join(' ');\n\nconst reserve = hashtagLine ? (2 + hashtagLine.length) : 0;\nconst bodyLimit = Math.max(0, MASTODON_CHAR_LIMIT - reserve);\n\nlet body = caption;\nif (body.length > bodyLimit) {\n  const cut = body.slice(0, Math.max(0, bodyLimit - 1));\n  const lastBreak = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));\n  body = (lastBreak > bodyLimit * 0.5 ? cut.slice(0, lastBreak + 1) : cut) + '…';\n}\n\nconst tootText = hashtagLine ? (body + '\\n\\n' + hashtagLine) : body;\n\nconst hasImage = !!safeStr(j.imageFinalPath);\n\nreturn { json: { ...j, tootText, hasImage } };"
      },
