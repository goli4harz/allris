      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const list = $('Liste 2026-Ordner (Lesetest)').first();\nconst mkdir = $('Erstelle Testordner').first();\nconst upload = $('Lade Testdatei hoch').first();\nconst mkdirBase = $('Erstelle Basis-Ordner').first();\nconst mkdirReaktion = $('Erstelle Unterordner 02_reaktion').first();\nconst mkdirInstagram = $('Erstelle Unterordner Instagram').first();\nfunction summarize(label, item) {\n  if (!item) return label + ': kein Item (Knoten evtl. gar nicht erreicht)';\n  const j = item.json || {};\n  if (j.error) return label + ': FEHLER -> ' + JSON.stringify(j.error).slice(0, 400);\n  return label + ': OK -> ' + JSON.stringify(j).slice(0, 200);\n}\nreturn [{ json: {\n  listeErgebnis: summarize('Liste', list),\n  ordnerErgebnis: summarize('Ordner erstellen (einfacher Pfad)', mkdir),\n  uploadErgebnis: summarize('Datei hochladen (einfacher Pfad)', upload),\n  baseOrdnerErgebnis: summarize('Basis-Ordner (Umlaut+lang, wie Produktion)', mkdirBase),\n  reaktionOrdnerErgebnis: summarize('Ordner 02_reaktion (Kind von Basis-Ordner)', mkdirReaktion),\n  instagramOrdnerErgebnis: summarize('Unterordner Instagram (verschachtelt)', mkdirInstagram)\n} }];"
