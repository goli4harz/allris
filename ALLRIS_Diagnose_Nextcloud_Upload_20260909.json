        "jsCode": "const list = $('Liste 2026-Ordner (Lesetest)').first();\nconst mkdir = $('Erstelle Testordner').first();\nconst upload = $('Lade Testdatei hoch').first();\nfunction summarize(label, item) {\n  if (!item) return label + ': kein Item (Knoten evtl. gar nicht erreicht)';\n  const j = item.json || {};\n  if (j.error) return label + ': FEHLER -> ' + JSON.stringify(j.error).slice(0, 400);\n  return label + ': OK -> ' + JSON.stringify(j).slice(0, 200);\n}\nreturn [{ json: {\n  listeErgebnis: summarize('Liste', list),\n  ordnerErgebnis: summarize('Ordner erstellen', mkdir),\n  uploadErgebnis: summarize('Datei hochladen', upload)\n} }];"
